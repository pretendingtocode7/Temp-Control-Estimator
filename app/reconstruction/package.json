{
  "name": "temp-control-estimate-builder-reconstruction",
  "version": "0.4.8-reconstruction.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run verify:reference && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "playwright test",
    "test:selector": "playwright test --config=playwright.selector.config.js",
    "test:options": "playwright test --config=playwright.options.config.js",
    "format": "prettier --write src tests vite.config.js playwright.config.js",
    "verify:reference": "node tools/verify-reference.mjs"
  },
  "dependencies": {
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
