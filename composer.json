{
    "name": "sevendegrees/temp-control-estimate-builder",
    "description": "WordPress plugin: mobile-first estimate builder for Temp Control HVAC field techs, integrated with Zoho.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "mustache/mustache": "^2.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.4",
        "squizlabs/php_codesniffer": "^3.8",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "TempControl\\Estimate\\": "includes/",
            "TempControl\\Estimate\\Endpoints\\": "endpoints/",
            "TempControl\\Estimate\\Admin\\": "admin/",
            "TempControl\\Estimate\\PublicSite\\": "public/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TempControl\\Estimate\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml",
        "lint": "phpcs --standard=WordPress includes/ endpoints/ admin/ public/"
    }
}
